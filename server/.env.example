# Port (automatically assigned by Render / Railway / Heroku in production)
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/prepsense_ai?retryWrites=true&w=majority

# JWT secret key for signing authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL for CORS (or * for public API)
CLIENT_URL=https://your-frontend-app.vercel.app
